<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="512"
    android:viewportHeight="512">

    <!-- Ambient Core Glow -->
    <path
        android:pathData="M256,164 A92,92 0 1,0 256,348 A92,92 0 1,0 256,164 Z"
        android:fillColor="#FF38BDF8"
        android:fillAlpha="0.06" />

    <!-- Screen Dark AMOLED Glass (W=170, H=198, rx=48, centered at 256, 256) -->
    <path
        android:pathData="M218,157 L294,157 A48,48 0 0,1 341,204 L341,308 A48,48 0 0,1 294,355 L218,355 A48,48 0 0,1 171,308 L171,204 A48,48 0 0,1 218,157 Z"
        android:fillColor="#FF020617"
        android:strokeWidth="1.5"
        android:strokeColor="#FF1E293B" />

    <!-- Glowing Cast Rail Frame with Lower-Left Opening -->
    <path
        android:pathData="M171,249 L171,204 A48,48 0 0,1 218,157 L294,157 A48,48 0 0,1 341,204 L341,308 A48,48 0 0,1 294,355 L249,355"
        android:strokeWidth="13"
        android:strokeLineCap="round"
        android:strokeLineJoin="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="171"
                android:startY="157"
                android:endX="341"
                android:endY="355"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF38BDF8" />
                <item android:offset="0.5" android:color="#FF34D399" />
                <item android:offset="1.0" android:color="#FF10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 3-Tier Cast Waves in lower-left opening -->
    <!-- Origin Beacon Dot -->
    <path
        android:pathData="M187,323.5 A8.5,8.5 0 1,0 187,340.5 A8.5,8.5 0 1,0 187,323.5 Z"
        android:fillColor="#FF38BDF8" />
    <path
        android:pathData="M187,328.5 A3.5,3.5 0 1,0 187,335.5 A3.5,3.5 0 1,0 187,328.5 Z"
        android:fillColor="#FFFFFFFF" />

    <!-- Wave 1 (Radius 28) -->
    <path
        android:pathData="M187,304 A28,28 0 0,1 215,332"
        android:strokeWidth="11"
        android:strokeColor="#FF38BDF8"
        android:strokeLineCap="round" />

    <!-- Wave 2 (Radius 55) -->
    <path
        android:pathData="M187,277 A55,55 0 0,1 242,332"
        android:strokeWidth="11"
        android:strokeColor="#FF34D399"
        android:strokeLineCap="round" />

    <!-- Wave 3 (Radius 81) -->
    <path
        android:pathData="M187,251 A81,81 0 0,1 268,332"
        android:strokeWidth="11"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="187"
                android:startY="332"
                android:endX="268"
                android:endY="251"
                android:type="linear">
                <item android:offset="0.0" android:color="#FF38BDF8" />
                <item android:offset="0.5" android:color="#FF34D399" />
                <item android:offset="1.0" android:color="#FF10B981" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Live 60fps Stream Pulse (Upper Right) -->
    <path
        android:pathData="M304,189 A5,5 0 1,0 304,199 A5,5 0 1,0 304,189 Z"
        android:fillColor="#FF34D399" />
    <path
        android:pathData="M304,183 A11,11 0 1,0 304,205 A11,11 0 1,0 304,183 Z"
        android:strokeWidth="1.5"
        android:strokeColor="#FF34D399"
        android:strokeAlpha="0.35" />

    <!-- Stealth Blackout Laser Beam -->
    <path
        android:pathData="M231,234 L320,234"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="231"
                android:startY="234"
                android:endX="320"
                android:endY="234"
                android:type="linear">
                <item android:offset="0.0" android:color="#0038BDF8" />
                <item android:offset="0.25" android:color="#9938BDF8" />
                <item android:offset="0.5" android:color="#F2FFFFFF" />
                <item android:offset="0.75" android:color="#9934D399" />
                <item android:offset="1.0" android:color="#0010B981" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
